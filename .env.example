# Supabase 项目配置（Project Settings -> API）
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# PWA Web Push：VAPID 公钥（前端读取，私钥只放在 Edge Function 环境变量里）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>

# 访问统计（Umami）：留空则完全不加载统计脚本，不发任何外部请求
NEXT_PUBLIC_UMAMI_WEBSITE_ID=<umami-website-id>
# 自托管 Umami 时填实例的 script.js 地址；用云端可留空（默认 cloud.umami.is）
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# 测试夹具用账号口令（不要写进仓库；轮换后放这里）
E2E_ADMIN_EMAIL=<owner-email>
E2E_ADMIN_PASSWORD=<owner-password>
E2E_STAFF_EMAIL=<staff-email>
E2E_STAFF_PASSWORD=<staff-password>
E2E_MEMBER_EMAIL=<member-email>
E2E_MEMBER_PASSWORD=<member-password>

# Edge Function 侧（用 supabase secrets set，绝不出现在前端）：
#   SUPABASE_SERVICE_ROLE_KEY  VAPID_PUBLIC_KEY  VAPID_PRIVATE_KEY  VAPID_SUBJECT
#   RESEND_API_KEY  RESEND_FROM
